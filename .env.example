APP_NAME=GIYA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── PostgreSQL ────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=giya_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────
# 'log' keeps the app fully offline: reset links land in
# storage/logs/laravel.log instead of being sent over the network.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@giya.local"
MAIL_FROM_NAME="${APP_NAME}"
